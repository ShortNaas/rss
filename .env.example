# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in. Never commit real credentials
# here: .env.example is the tracked template.
#
# Use the POOLED connection string from the Neon dashboard: the host must
# contain "-pooler". Neon appends ?sslmode=require, which is required.
#
# When DATABASE_URL is set the app uses Neon; when unset it falls back to
# embedded PGlite in ./.pglite-data (fine locally, NOT persistent on Vercel).
#
# Migrations run automatically on the first request, but apply them explicitly
# first so failures are visible:
#   npm run db:migrate    # apply migrations
#   npm run db:check      # verify connection + schema without mutating
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: override where the local PGlite database is stored.
# PGLITE_DATA_DIR=./.pglite-data

# ---------------------------------------------------------------------------
# Auth (single-user password gate)
# ---------------------------------------------------------------------------
# Leave APP_PASSWORD unset to disable auth entirely (the app is then public).
APP_PASSWORD=
# Signs the session cookie. Defaults to APP_PASSWORD if unset; set it explicitly
# in production so rotating the password is a deliberate act.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Required by /api/cron/refresh. Vercel sends it automatically as
# "Authorization: Bearer $CRON_SECRET" for cron-triggered requests.
CRON_SECRET=
